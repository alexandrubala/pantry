{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pantry",
  "compatibility_date": "2026-09-05",
  "main": "./worker/index.ts",
  // Better Auth uses AsyncLocalStorage. Node.js compatibility (including ALS)
  // is already on for this compatibility date (2026-08-04+); do not add a
  // redundant nodejs_compat flag.
  // Secrets belong in Cloudflare / .dev.vars, never in this file.
  // Public non-secret vars may be committed here.
  "vars": {
    "BETTER_AUTH_URL": "https://pantry.alexandrubala94.workers.dev",
  },
  // Vite plugin sets assets.directory from the client build. Do not set it here.
  // /api/* → Worker first. Everything else → static assets / React SPA fallback.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // Local Vite/Wrangler uses a simulated D1 by default. Do not set remote: true.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pantry",
      "database_id": "d95a8fcf-545c-46c1-82df-998f96dd8cc7",
      // Canonical SQL lives in packages/database so D1 and a future local SQLite runner share one history.
      "migrations_dir": "../../packages/database/migrations",
    },
  ],
  // Reserved for future Pantry-owned assets. No uploads or public access yet.
  // Local Vite/Wrangler uses a simulated R2 by default. Do not set remote: true.
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "pantry-assets",
    },
  ],
}
