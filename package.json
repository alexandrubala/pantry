{
  "name": "pantry",
  "private": true,
  "version": "0.0.0",
  "description": "Household inventory PWA monorepo",
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:migrate:local": "pnpm --filter web db:migrate:local",
    "db:migrate:remote": "pnpm --filter web db:migrate:remote",
    "db:migrations:list:local": "pnpm --filter web db:migrations:list:local",
    "db:migrations:list:remote": "pnpm --filter web db:migrations:list:remote"
  }
}
